# Copy to .env.local for development, and set the same keys in the Hostinger
# hPanel environment variables for the deployed app (nextjs-deploy-hostinger §1).
# Nothing here is required to run the site: every value degrades gracefully.

# ---------------------------------------------------------------- site ---
# Canonical origin, no trailing slash. Set this on staging too, so staging
# never canonicalises to production.
NEXT_PUBLIC_SITE_URL=https://contador.com.py

# ------------------------------------------------------------- contacto ---
# Firm contact details (plan.md §7). While unset, the header/footer rows, the
# WhatsApp floating button and the tel:/mailto: links simply do not render.
# WhatsApp is digits only, international, no "+": 595981123456
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_EMAIL=

# ------------------------------------------------------------ VenderCRM ---
# Server-only — never prefix these with NEXT_PUBLIC_, it would ship the key to
# the browser. Both come from VenderCRM → Sitios (one key per site).
# With either missing, POST /api/lead still answers 200 with degraded: true,
# logs the lead and the UI keeps offering WhatsApp.
VENDERCRM_URL=
VENDERCRM_API_KEY=

# ------------------------------------------------------------ analytics ---
# Wired in phase B4. The analytics helper is a no-op until these are set.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=

# ----------------------------------------------------------------- test ---
# Port used by `npm run smoke`. Change only if 4321 is taken locally.
SMOKE_PORT=4321
